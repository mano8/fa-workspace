{
  "name": "Microservices FastApi Sandbox",

  "dockerComposeFile": "docker-compose.devcontainer.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",

  "remoteUser": "vscode",

  "features": {
    "ghcr.io/devcontainers/features/node@sha256:fedd4c11f7adfb64283b578dddc7da906728daa25fa293351c9d913231acf12f": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/python@sha256:fbcad6955caeecc5ad3f7886baf652e25cba5225a6c4c2287c536de2e5607511": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker@sha256:c2c2cf829505ead8e4892c88c31b6594ae94a2bbb209e16e1fac456c1a3a624e": {
      "version": "29.6.1",
      "moby": false
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code@sha256:cfc2e7d3e9fd3b9b01f8d5cb158508a884c8c0ede2e23ed10f32dea5d4ffe69a": {}
  },

  "remoteEnv": {
    "PATH": "/home/vscode/.venvs/headroom/bin:${containerEnv:PATH}",
    "HEADROOM_PROXY_URL": "http://headroom-proxy:8787"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt@26.707.91948",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.pylint",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "davidanson.vscode-markdownlint",
        "ms-vscode.makefile-tools",
        "ms-vscode.vscode-typescript-next",
        "astro-build.astro-vscode"
      ],
      "settings": {
        "extensions.supportNodeGlobalNavigator": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/workspace/.shared-venv/bin/python",
        "python.testing.pytestPath": "/workspace/.shared-venv/bin/pytest",
        "python.analysis.indexing": false,
        "python.analysis.diagnosticMode": "openFilesOnly",

        "files.watcherExclude": {
          "**/.shared-venv/**": true,
          "**/.venv/**": true,
          "**/__pycache__/**": true,
          "**/.pytest_cache/**": true,
          "**/.mypy_cache/**": true,
          "**/.ruff_cache/**": true
        },
        "files.exclude": {
          "**/.shared-venv": true,
          "**/.venv": true,
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.mypy_cache": true,
          "**/.ruff_cache": true
        },
        "search.exclude": {
          "**/.shared-venv": true,
          "**/.venv": true,
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.mypy_cache": true,
          "**/.ruff_cache": true
        }
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/configure-mcp.sh",

  "forwardPorts": []
}
