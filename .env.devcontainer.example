# Portable dev-container workspace tool profile.
# Copy to .env.devcontainer when container-specific overrides are needed.

M8_WORKSPACE_ROOT=/workspace
M8_RUNTIME=devcontainer
M8_HOST_OS=linux

M8_PYTHON_ENV_KIND=venv
M8_PYTHON=/workspace/.shared-venv/bin/python
M8_PYTHON_MANAGER=
M8_PYTHON_ENV_NAME=.shared-venv

M8_JS_RUNTIME_KIND=node
M8_JS_RUNTIME=node
M8_PACKAGE_MANAGER_KIND=npm
M8_PACKAGE_MANAGER=npm
M8_PACKAGE_EXECUTOR=npx

M8_VCS_KIND=git
M8_VCS=git

M8_CONTAINER_ENGINE_KIND=docker
M8_CONTAINER_ENGINE=docker
M8_COMPOSE_KIND=docker-compose
M8_COMPOSE=docker-compose

# Optional additional resolved tools use M8_TOOL_<NAME>.
