# Host-local workspace tool profile for Windows, Linux, or macOS.
# Copy to .env.local and replace every changethis value.

M8_WORKSPACE_ROOT=changethis
M8_RUNTIME=local
M8_HOST_OS=changethis

# Select any Python environment strategy. Examples: conda, venv, virtualenv,
# uv, poetry, pipenv, pyenv, system, other, or none.
M8_PYTHON_ENV_KIND=changethis
M8_PYTHON=changethis
M8_PYTHON_MANAGER=
M8_PYTHON_ENV_NAME=

# Repository metadata/lockfiles override this default package manager.
M8_JS_RUNTIME_KIND=changethis
M8_JS_RUNTIME=changethis
M8_PACKAGE_MANAGER_KIND=changethis
M8_PACKAGE_MANAGER=changethis
M8_PACKAGE_EXECUTOR=

M8_VCS_KIND=git
M8_VCS=git

# Set optional tool families to kind=none with an empty command.
M8_CONTAINER_ENGINE_KIND=changethis
M8_CONTAINER_ENGINE=changethis
M8_COMPOSE_KIND=changethis
M8_COMPOSE=changethis

# Optional additional resolved tools use M8_TOOL_<NAME>, for example:
# M8_TOOL_RUFF=ruff
# M8_TOOL_TERRAFORM=terraform
