# Ignore every root-level entry by default.
/*
!/sbom/
!/sbom/root-tooling.cdx.json

# Files owned by fa-workspace.
!/.gitignore
!/.gitattributes
!/.m8-workspace-root
!/README.md
!/README.*.md
!/LICENSE
!/fa-workspace.code-workspace

# Workspace tool profiles. Real machine values stay local; safe templates are
# shared.
/.env.local
/.env.devcontainer
!/.env.local.example
!/.env.devcontainer.example

# Directories owned by fa-workspace.

# Root-only workspace policy CI. Child repositories own their own workflows.
!/.github/
!/.github/**

# Shared tool-neutral workspace truth.
!/.workspace/
!/.workspace/**
**/todo/**
/.workspace/plans/**
# Status artifacts are strictly local evidence and must never be committed.
/.workspace/status/
/.workspace/analyse/**
.workspace/.runtime/
.workspace/.cache/

# Versioned local safety hooks that reject commits and pushes containing TODO plans.
!/.githooks/
!/.githooks/**

# Codex
!/AGENTS.md
# Allow Git to traverse .codex and .agents.
!/.codex/
!/.agents/
# Keep Codex-local state private by default.
/.codex/**
!/.codex/README.md
!/.codex/config.toml

# Claude
!/CLAUDE.md
# Allow Git to traverse .claude.
!/.claude/
# Keep Claude-local state private by default.
/.claude/**
!/.claude/settings.json
/.claude/settings.local.json
CLAUDE.local.md
# Track shareable Claude-specific tooling, but not local permissions, locks, or
# memory.
!/.claude/README.md
!/.claude/agents/
!/.claude/agents/**

# DevContainer
!/.devcontainer/
/.devcontainer/.back/**

# VSCode
!/.vscode/

# Config
!/config/
!/scripts/
!/scripts/**
!/docs/

# Python
*.pyc
